# Copy or run python -m scripts.dev init for generated local credentials.
DEMO=true
DEMO_PASSWORD=replace-with-unique-password-at-least-12-characters
DATABASE_URL=sqlite:///runtime/coordinator.db
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
BANK_A_REGISTRATION_INVITE=replace-with-bank-a-issued-invite
BANK_B_REGISTRATION_INVITE=replace-with-bank-b-issued-invite
BANK_C_REGISTRATION_INVITE=replace-with-bank-c-issued-invite
BANK_A_CLIENT_KEY=replace-with-unique-bank-a-secret
BANK_A_ENDPOINT=http://127.0.0.1:8101
BANK_B_CLIENT_KEY=replace-with-unique-bank-b-secret
BANK_B_ENDPOINT=http://127.0.0.1:8102
BANK_C_CLIENT_KEY=replace-with-unique-bank-c-secret
BANK_C_ENDPOINT=http://127.0.0.1:8103
LLM_PROVIDER=demo
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Empty means explicit lightweight retrieval fallback. Configuring downloads model weights.
SEMANTIC_MODEL=
RERANKER_MODEL=
# Docker PostgreSQL password, set a unique value before compose up.
POSTGRES_PASSWORD=
