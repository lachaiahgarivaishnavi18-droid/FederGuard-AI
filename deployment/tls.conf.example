# Terminate TLS on your institution-controlled ingress; use valid certificates.
server {
    listen 443 ssl;
    server_name federguard.example;
    ssl_certificate /run/secrets/server_cert;
    ssl_certificate_key /run/secrets/server_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / { proxy_pass http://frontend:80; proxy_set_header X-Forwarded-Proto https; }
}
